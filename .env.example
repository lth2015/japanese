# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google Cloud STT/TTS — use a service account JSON.
# Either set GOOGLE_APPLICATION_CREDENTIALS to the path of a key file,
# or paste the JSON content into GOOGLE_CLOUD_CREDENTIALS_JSON.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_CREDENTIALS_JSON=

# Database file (default: ./data/app.db)
DATABASE_URL=./data/app.db

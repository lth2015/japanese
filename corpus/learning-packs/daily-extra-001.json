  { "zh": "我来做饭吧。", "ja": "ご飯作るね。", "kana": "ごはんつくるね", "scene": "吃饭" },
  { "zh": "帮我拿一下盐。", "ja": "塩取ってくれる？", "kana": "しおとってくれる", "scene": "吃饭" },
  { "zh": "再来一碗。", "ja": "おかわりください。", "kana": "おかわりください", "scene": "吃饭" },
  { "zh": "伞带了吗？", "ja": "傘持った？", "kana": "かさもった", "scene": "出门" },
  { "zh": "我送你到车站。", "ja": "駅まで送るよ。", "kana": "えきまでおくるよ", "scene": "出门" },

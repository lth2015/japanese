    { "externalId": "s003", "japanese": "待ちきれない。", "tokens": [{ "text": "待ちきれない", "kana": "まちきれない" }, { "text": "。" }], "kana": "まちきれない", "chinese": "等不及了。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 986, "chunkPattern": "待ちきれない", "tags": ["display", "anticipation", "cant-wait"] },
    { "externalId": "s004", "japanese": "今からドキドキする。", "tokens": [{ "text": "今", "kana": "いま" }, { "text": "からドキドキする。" }], "kana": "いまからどきどきする", "chinese": "现在就开始小鹿乱撞。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 970, "chunkPattern": "今から〜する", "tags": ["display", "anticipation", "nervous-excited"] },

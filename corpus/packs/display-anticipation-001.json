    { "externalId": "s014", "japanese": "楽しみで眠れない。", "tokens": [{ "text": "楽しみ", "kana": "たのしみ" }, { "text": "で" }, { "text": "眠れない", "kana": "ねむれない" }, { "text": "。" }], "kana": "たのしみでねむれない", "chinese": "期待得睡不着。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 958, "chunkPattern": "〜で眠れない", "tags": ["display", "anticipation", "cant-sleep"] },
    { "externalId": "s015", "japanese": "どんな感じか気になる。", "tokens": [{ "text": "どんな" }, { "text": "感じ", "kana": "かんじ" }, { "text": "か" }, { "text": "気になる", "kana": "きになる" }, { "text": "。" }], "kana": "どんなかんじかきになる", "chinese": "很想知道是什么感觉。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 960, "chunkPattern": "どんな〜か気になる", "tags": ["display", "anticipation", "curious"] },

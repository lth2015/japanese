    { "externalId": "s006", "japanese": "早く明日にならないかな。", "tokens": [{ "text": "早く", "kana": "はやく" }, { "text": "明日", "kana": "あした" }, { "text": "にならないかな。" }], "kana": "はやくあしたにならないかな", "chinese": "明天快点来吧。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 964, "chunkPattern": "早く〜にならないかな", "tags": ["display", "anticipation", "tomorrow-please"] },
    { "externalId": "s007", "japanese": "ずっと待ってた。", "tokens": [{ "text": "ずっと" }, { "text": "待ってた", "kana": "まってた" }, { "text": "。" }], "kana": "ずっとまってた", "chinese": "一直在等。", "category": "smalltalk", "register": "カジュアル", "difficulty": 1, "frequencyRank": 980, "chunkPattern": "ずっと待ってた", "tags": ["display", "anticipation", "long-awaited"] },
    { "externalId": "s008", "japanese": "当日が待ち遠しい。", "tokens": [{ "text": "当日", "kana": "とうじつ" }, { "text": "が" }, { "text": "待ち遠しい", "kana": "まちどおしい" }, { "text": "。" }], "kana": "とうじつがまちどおしい", "chinese": "盼着那天。", "category": "smalltalk", "register": "カジュアル", "difficulty": 3, "frequencyRank": 948, "chunkPattern": "〜が待ち遠しい", "tags": ["display", "anticipation", "the-day"] },
    { "externalId": "s009", "japanese": "想像するだけで楽しい。", "tokens": [{ "text": "想像", "kana": "そうぞう" }, { "text": "するだけで" }, { "text": "楽しい", "kana": "たのしい" }, { "text": "。" }], "kana": "そうぞうするだけでたのしい", "chinese": "光想想就开心。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 956, "chunkPattern": "想像するだけで〜", "tags": ["display", "anticipation", "just-imagining"] },
    { "externalId": "s010", "japanese": "今週末が楽しみ。", "tokens": [{ "text": "今週末", "kana": "こんしゅうまつ" }, { "text": "が" }, { "text": "楽しみ", "kana": "たのしみ" }, { "text": "。" }], "kana": "こんしゅうまつがたのしみ", "chinese": "期待这周末。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 972, "chunkPattern": "〜が楽しみ", "tags": ["display", "anticipation", "weekend"] },

    { "externalId": "s006", "japanese": "もう何もしたくない。", "tokens": [{ "text": "もう" }, { "text": "何も", "kana": "なにも" }, { "text": "したくない。" }], "kana": "もうなにもしたくない", "chinese": "什么都不想做了。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 980, "chunkPattern": "もう何も〜ない", "tags": ["display", "fatigue", "drained"] },

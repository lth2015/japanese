    { "externalId": "s003", "japanese": "だるい。", "tokens": [{ "text": "だるい。" }], "kana": "だるい", "chinese": "好没劲。", "category": "smalltalk", "register": "カジュアル", "difficulty": 1, "frequencyRank": 994, "chunkPattern": "だるい", "tags": ["display", "fatigue", "sluggish"] },

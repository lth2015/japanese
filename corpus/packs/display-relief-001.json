    { "externalId": "s002", "japanese": "ほっとした。", "tokens": [{ "text": "ほっとした。" }], "kana": "ほっとした", "chinese": "松了口气。", "category": "smalltalk", "register": "カジュアル", "difficulty": 1, "frequencyRank": 995, "chunkPattern": "ほっとした", "tags": ["display", "relief", "relieved"] },
    { "externalId": "s003", "japanese": "助かった。", "tokens": [{ "text": "助かった", "kana": "たすかった" }, { "text": "。" }], "kana": "たすかった", "chinese": "帮大忙了。", "category": "smalltalk", "register": "カジュアル", "difficulty": 1, "frequencyRank": 994, "chunkPattern": "助かった", "tags": ["display", "relief", "saved"] },
    { "externalId": "s004", "japanese": "これで安心。", "tokens": [{ "text": "これで" }, { "text": "安心", "kana": "あんしん" }, { "text": "。" }], "kana": "これであんしん", "chinese": "这下放心了。", "category": "smalltalk", "register": "カジュアル", "difficulty": 1, "frequencyRank": 990, "chunkPattern": "これで〜", "tags": ["display", "relief", "secure"] },
    { "externalId": "s005", "japanese": "間に合った。", "tokens": [{ "text": "間に合った", "kana": "まにあった" }, { "text": "。" }], "kana": "まにあった", "chinese": "赶上了。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 988, "chunkPattern": "間に合った", "tags": ["display", "relief", "made-it"] },
    { "externalId": "s006", "japanese": "やっと終わった。", "tokens": [{ "text": "やっと" }, { "text": "終わった", "kana": "おわった" }, { "text": "。" }], "kana": "やっとおわった", "chinese": "总算结束了。", "category": "progress", "register": "カジュアル", "difficulty": 1, "frequencyRank": 992, "chunkPattern": "やっと〜終わった", "tags": ["display", "relief", "done"] },
    { "externalId": "s007", "japanese": "心配して損した。", "tokens": [{ "text": "心配", "kana": "しんぱい" }, { "text": "して" }, { "text": "損した", "kana": "そんした" }, { "text": "。" }], "kana": "しんぱいしてそんした", "chinese": "白担心了。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 962, "chunkPattern": "〜して損した", "tags": ["display", "relief", "worried-for-nothing"] },
    { "externalId": "s008", "japanese": "肩の荷が下りた。", "tokens": [{ "text": "肩", "kana": "かた" }, { "text": "の" }, { "text": "荷", "kana": "に" }, { "text": "が" }, { "text": "下りた", "kana": "おりた" }, { "text": "。" }], "kana": "かたのにがおりた", "chinese": "卸下了肩上的担子。", "category": "smalltalk", "register": "カジュアル", "difficulty": 3, "frequencyRank": 955, "chunkPattern": "肩の荷が下りた", "tags": ["display", "relief", "burden-off"] },
    { "externalId": "s009", "japanese": "うまくいってよかった。", "tokens": [{ "text": "うまくいって" }, { "text": "よかった。" }], "kana": "うまくいってよかった", "chinese": "顺利就好。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 980, "chunkPattern": "〜てよかった", "tags": ["display", "relief", "went-well"] },
    { "externalId": "s010", "japanese": "もう大丈夫。", "tokens": [{ "text": "もう" }, { "text": "大丈夫", "kana": "だいじょうぶ" }, { "text": "。" }], "kana": "もうだいじょうぶ", "chinese": "已经没事了。", "category": "smalltalk", "register": "カジュアル", "difficulty": 1, "frequencyRank": 986, "chunkPattern": "もう大丈夫", "tags": ["display", "relief", "ok-now"] },
    { "externalId": "s011", "japanese": "ひとまず安心した。", "tokens": [{ "text": "ひとまず" }, { "text": "安心", "kana": "あんしん" }, { "text": "した。" }], "kana": "ひとまずあんしんした", "chinese": "暂时放心了。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 970, "chunkPattern": "ひとまず〜した", "tags": ["display", "relief", "for-now"] },
    { "externalId": "s012", "japanese": "無事でよかった。", "tokens": [{ "text": "無事", "kana": "ぶじ" }, { "text": "で" }, { "text": "よかった。" }], "kana": "ぶじでよかった", "chinese": "平安无事就好。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 978, "chunkPattern": "無事でよかった", "tags": ["display", "relief", "safe"] },
    { "externalId": "s013", "japanese": "これで一安心。", "tokens": [{ "text": "これで" }, { "text": "一安心", "kana": "ひとあんしん" }, { "text": "。" }], "kana": "これでひとあんしん", "chinese": "这下放心了。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 974, "chunkPattern": "これで一安心", "tags": ["display", "relief", "settled"] },
    { "externalId": "s014", "japanese": "やっと落ち着いた。", "tokens": [{ "text": "やっと" }, { "text": "落ち着いた", "kana": "おちついた" }, { "text": "。" }], "kana": "やっとおちついた", "chinese": "总算稳定下来了。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 976, "chunkPattern": "やっと落ち着いた", "tags": ["display", "relief", "calmed-down"] },
    { "externalId": "s015", "japanese": "不安が消えた。", "tokens": [{ "text": "不安", "kana": "ふあん" }, { "text": "が" }, { "text": "消えた", "kana": "きえた" }, { "text": "。" }], "kana": "ふあんがきえた", "chinese": "不安消失了。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 958, "chunkPattern": "不安が消えた", "tags": ["display", "relief", "worry-gone"] },
    { "externalId": "s016", "japanese": "思ったより大丈夫だった。", "tokens": [{ "text": "思ったより", "kana": "おもったより" }, { "text": "大丈夫", "kana": "だいじょうぶ" }, { "text": "だった。" }], "kana": "おもったよりだいじょうぶだった", "chinese": "比想象中没事。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 964, "chunkPattern": "思ったより〜だった", "tags": ["display", "relief", "better-than-feared"] },
    { "externalId": "s017", "japanese": "解決してよかった。", "tokens": [{ "text": "解決", "kana": "かいけつ" }, { "text": "して" }, { "text": "よかった。" }], "kana": "かいけつしてよかった", "chinese": "解决了真好。", "category": "progress", "register": "カジュアル", "difficulty": 2, "frequencyRank": 968, "chunkPattern": "〜してよかった", "tags": ["display", "relief", "resolved"] },
    { "externalId": "s018", "japanese": "ほっと一息。", "tokens": [{ "text": "ほっと" }, { "text": "一息", "kana": "ひといき" }, { "text": "。" }], "kana": "ほっとひといき", "chinese": "松一口气。", "category": "smalltalk", "register": "カジュアル", "difficulty": 2, "frequencyRank": 960, "chunkPattern": "ほっと一息", "tags": ["display", "relief", "breather"] },
